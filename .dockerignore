# Only files used by the Dockerfile enter the build context.
*
!Dockerfile
!.dockerignore
!requirements.txt
!requirements-dev.txt
!pyproject.toml
!scripts/
!scripts/*.py
!dags/
!dags/*.py
!sql/
!sql/init_dwh_schema.sql
!sql/02_olap_views.sql
!sql/03_station_daily_rain.sql
!tests/
!tests/**
**/__pycache__/
**/*.pyc
**/.pytest_cache/
