# ==============================================================================
# Environment Configuration - Weather Data Lake & Data Warehouse
# ==============================================================================

# --- MinIO (Data Lake) Configuration ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_SECURE=false

# Default Data Lake Buckets
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- PostgreSQL (Data Warehouse & Airflow Metadata) Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airflow
DWH_DB=weather_dwh
POSTGRES_HOST=postgres
# Cổng host: dùng 5434 để tránh xung đột nếu cổng 5432 trên máy đã được dùng
POSTGRES_PORT=5434
POSTGRES_INTERNAL_PORT=5432

# --- Apache Airflow Configuration ---
# Airflow image/version is defined in Dockerfile and docker-compose.yml.
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_WEBSERVER_PORT=8080

# Secret keys (sinh ngẫu nhiên cho môi trường production/dev)
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqJZPo=
AIRFLOW__WEBSERVER__SECRET_KEY=weather_airflow_secret_key_session_2026_dwh
